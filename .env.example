WEB_AUTH_MODE=public
# Next.js runs the speech handlers. Use external to opt into the legacy relay.
SPEECH_RELAY_MODE=embedded
TNSA_API_KEY=
UPSTREAM_API_KEY=
ORIGINCHAIN_BASE_URL=
ORIGINCHAIN_TOKEN=
ORIGINCHAIN_TENANT=
# Set these for external relay mode.
SPEECH_API_URL=https://speech.tnsaai.com
SPEECH_API_KEY=
CF_ACCESS_TEAM_DOMAIN=https://YOUR-TEAM.cloudflareaccess.com
CF_ACCESS_AUD=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional server-only resolver if local DNS has a stale result. Normally leave unset.
# SPEECH_DNS_SERVER=1.1.1.1
